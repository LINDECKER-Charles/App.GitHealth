<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <!--
    The MIT license requires only one thing: that the copyright notice follows the
    software. These properties write it into the assembly metadata, and therefore into
    the distributed binaries, not only into the repository's LICENSE file.
  -->
  <PropertyGroup>
    <Product>GitHealth</Product>
    <Authors>Charles LINDECKER</Authors>
    <Copyright>Copyright (c) 2026 Charles LINDECKER</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/LINDECKER-Charles/App.GitHealth</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LINDECKER-Charles/App.GitHealth.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
