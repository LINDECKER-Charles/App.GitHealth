{
  "Persistence": {
    "DatabasePath": "data/githealth.db",
    "WriteTimeoutSeconds": 5,
    "RetentionDays": null
  },
  "AnalysisQueue": {
    "Capacity": 32,
    "TimeoutSeconds": 300
  },
  "GitHealth": {
    "Git": {
      "CommandTimeout": "00:00:30",
      "MaximumOutputBytes": 4194304,
      "MaximumParallelCommands": 4,
      "UseAheadBehind": true
    },
    "Assistant": {
      "Enabled": true,
      "RunTimeout": "00:03:00",
      "MaximumOutputBytes": 4194304,
      "MaximumBranches": 200,
      "MaximumParallelRuns": 1
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]"
}
