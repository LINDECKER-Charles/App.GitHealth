<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\App.GitHealth.Core\App.GitHealth.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="githealth.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>
        runtime; build; native; contentfiles; analyzers; buildtransitive
      </IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>githealth</AssemblyName>
    <!--
      Window subsystem: on a double-click, the application must not drag a console
      alongside its window, since closing that console would stop it. Standard output
      stays readable from a terminal, TerminalOutput reconnects it there.
    -->
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>githealth.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <FrontendRoot>$(MSBuildProjectDirectory)/../App.GitHealth.Web</FrontendRoot>
    <FrontendDist>$(FrontendRoot)/dist/app-git-health-web/browser</FrontendDist>
    <BuildFrontend Condition="'$(BuildFrontend)' == ''">true</BuildFrontend>
    <PublishTrimmed>false</PublishTrimmed>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <Target Name="PublishFrontend"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(BuildFrontend)' == 'true'">
    <Exec WorkingDirectory="$(FrontendRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(FrontendRoot)" Command="npm run build" />

    <Error Condition="!Exists('$(FrontendDist)/index.html')"
           Text="The Angular build did not produce index.html." />

    <ItemGroup>
      <FrontendFiles Include="$(FrontendDist)/**/*" />
      <ResolvedFileToPublish Include="@(FrontendFiles->'%(FullPath)')"
                             Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
