# Dossier hôte contenant les dépôts à analyser. Compose le monte dans
# /repositories en lecture seule (:ro).
# Windows : D:/Dev/Repos
# macOS/Linux : /Users/alice/Dev/Repos ou /home/alice/Dev/Repos
GITHEALTH_REPOSITORIES_ROOT=.

# Port publié uniquement sur 127.0.0.1. Le conteneur écoute toujours sur 8080.
GITHEALTH_HTTP_PORT=8080

# Les données SQLite ne sont pas stockées dans ce dossier : elles restent dans
# le volume Docker nommé githealth-data.
