# Host folder holding the repositories to analyse. Compose mounts it in
# /repositories as read only (:ro).
# Windows: D:/Dev/Repos
# macOS/Linux: /Users/alice/Dev/Repos or /home/alice/Dev/Repos
GITHEALTH_REPOSITORIES_ROOT=.

# Port published on 127.0.0.1 only. The container always listens on 8080.
GITHEALTH_HTTP_PORT=8080

# The SQLite data is not stored in this folder: it stays in the Docker volume
# named githealth-data.
