# Auto detect text files and perform LF normalization
* text=auto

# Ressources binaires : aucune normalisation de fin de ligne, sur aucun système.
*.ttf binary
*.ico binary

# Passerelles de build : le shebang exige des fins de ligne LF, cmd.exe des CRLF.
*.sh text eol=lf
*.cmd text eol=crlf

# Hooks Git : le shebang exige des fins de ligne LF.
eng/hooks/* text eol=lf
