#!/bin/sh
# Refuse toute poussée qui réécrirait l'historique de dev ou de main.
#
# Le modèle de promotion exige que test reste un ancêtre de dev. Une réécriture le
# brise : le job promote pousse alors une référence qui n'est plus un descendant
# direct, l'API répond 422 et plus aucune promotion n'aboutit jusqu'à réparation
# manuelle. Ce hook est le substitut local à la protection de branche, indisponible
# sur un dépôt privé au plan GitHub Free.
#
# Activation : git config core.hooksPath eng/hooks

set -eu

branches_protegees="refs/heads/dev refs/heads/main"
sha_nul=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
refus=0

while read -r _ref_locale sha_local ref_distante sha_distant; do
    case " $branches_protegees " in
        *" $ref_distante "*) ;;
        *) continue ;;
    esac

    if [ "$sha_local" = "$sha_nul" ]; then
        echo "pre-push: suppression de $ref_distante refusée." >&2
        refus=1
        continue
    fi

    # Création de la référence distante : il n'y a pas d'historique à réécrire.
    if [ "$sha_distant" = "$sha_nul" ]; then
        continue
    fi

    if ! git merge-base --is-ancestor "$sha_distant" "$sha_local"; then
        echo "pre-push: $ref_distante serait réécrite." >&2
        echo "  $sha_distant n'est pas un ancêtre de $sha_local." >&2
        echo "  test cesserait d'être un ancêtre de dev et les promotions échoueraient." >&2
        refus=1
    fi
done

if [ "$refus" -ne 0 ]; then
    echo "  Passer --no-verify si la réécriture est délibérée et assumée." >&2
    exit 1
fi

exit 0
