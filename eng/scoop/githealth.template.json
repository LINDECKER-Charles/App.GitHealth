{
  "version": "__VERSION__",
  "description": "Local diagnostic of Git branches: what is merged, what has diverged, what is dormant.",
  "homepage": "https://github.com/LINDECKER-Charles/App.GitHealth",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/LINDECKER-Charles/App.GitHealth/releases/download/v__VERSION__/githealth-win-x64.zip",
      "hash": "__HASH__"
    }
  },
  "bin": "githealth.exe",
  "shortcuts": [["githealth.exe", "GitHealth"]],
  "checkver": {
    "url": "https://github.com/LINDECKER-Charles/App.GitHealth/releases",
    "regex": "releases/tag/v([\\d.]+(?:-[\\w.]+)?)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/LINDECKER-Charles/App.GitHealth/releases/download/v$version/githealth-win-x64.zip"
      }
    },
    "hash": {
      "url": "$url.sha256"
    }
  },
  "notes": [
    "The data lives in %LOCALAPPDATA%\\GitHealth: it survives both updates and uninstallation.",
    "GitHealth needs Git. Outside the PATH, point at it with --git-path <path>."
  ]
}
